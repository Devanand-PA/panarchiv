{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panarchiv",
  "version": "0.1.1",
  "identifier": "com.panarchiv.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Panarchiv",
        "width": 1200,
        "height": 820,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
